              <mxPoint x="520" y="1740" />
              <mxPoint x="915" y="1740" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_x_feature" value="X 2695×3000" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="prep_gene" target="prep_feature" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="440" y="344.9473684210525" as="sourcePoint" />
            <mxPoint x="1040" y="340.0000000000002" as="targetPoint" />
            <Array as="points">
              <mxPoint x="225" y="410" />
              <mxPoint x="1010" y="410" />
              <mxPoint x="1010" y="285" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_x_llm" value="X 2695×3000" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="prep_gene" target="llm_embed" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="225" y="420" />
              <mxPoint x="1500" y="420" />
              <mxPoint x="1500" y="190" />
              <mxPoint x="1815" y="190" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_sadj_norm" value="sadj 2695×2695" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" parent="1" source="prep_spatial" target="norm_graph" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="765" y="430" />
              <mxPoint x="330" y="430" />
            </Array>
          </mxGeometry>
        </mxCell>
